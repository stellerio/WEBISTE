precision highp float;uniform float uTime,uScroll;uniform vec2 uMouse;varying vec3 vP,vN;float h(vec3 p){p=fract(p*.3183+.1);p*=17.;return fract(p.x*p.y*p.z*(p.x+p.y+p.z));}float n(vec3 p){vec3 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);return mix(mix(mix(h(i),h(i+vec3(1,0,0)),f.x),mix(h(i+vec3(0,1,0)),h(i+vec3(1,1,0)),f.x),f.y),mix(mix(h(i+vec3(0,0,1)),h(i+vec3(1,0,1)),f.x),mix(h(i+vec3(0,1,1)),h(i+vec3(1,1,1)),f.x),f.y),f.z);}float fbm(vec3 p){float v=0.,a=.55;for(int i=0;i<5;i++){v+=n(p)*a;p=p*2.03+7.;a*=.5;}return v;}void main(){vec3 p=vP*.72;p.y+=uTime*.035;p.x+=uScroll*.45;p.z+=uMouse.x*.18;float d=fbm(p)+.32*fbm(p*2.7+4.)-.42;float edge=smoothstep(-.18,.34,d);float light=max(dot(normalize(vN),normalize(vec3(-.4,.8,.65))),0.);vec3 c=mix(vec3(.88,.96,1.),vec3(1.,.78,.52),smoothstep(.35,1.,uScroll)*.3);c+=vec3(.25,.55,.9)*pow(1.-light,2.)*.35;if(edge<.03)discard;gl_FragColor=vec4(c,edge*(.58+light*.35));}